# Copy this file to .env and fill in your real key.
# Loaded automatically by `npm run start:server` and `npm run test:live`
# via Node's built-in --env-file-if-exists flag — no extra setup needed.
RG_API_KEY=

# Optional, only relevant when deploying server/ (see README "Production
# deployment"). Not needed for local development.
# ALLOW_ORIGIN=chrome-extension://<your-extension-id>
# For multiple stores (Chrome Web Store, Edge Add-ons, ...), comma-separate
# each store's origin — every store assigns its own ID for the same package:
# ALLOW_ORIGIN=chrome-extension://<chrome-id>,chrome-extension://<edge-id>
# NODE_ENV=production

# Optional. A Discord (or other) webhook URL — if set, the server posts an
# alert there when upstream (RescueGroups) failures spike (5+ in 10 min),
# with a 30-min cooldown between alerts. Left unset, alerting is a no-op.
# ALERT_WEBHOOK_URL=
